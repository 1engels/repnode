{
  "name": "@repnode/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../../packages/shared/src --watch-preserve-output --env-file-if-exists=.env.local src/index.ts",
    "start": "node --env-file-if-exists=.env.local src/index.ts --prod",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "node --env-file-if-exists=.env.test.local scripts/bench.ts",
    "check:vm": "node --env-file-if-exists=.env.test.local scripts/check-vm.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@repnode/shared": "workspace:*",
    "archiver": "^8.0.0",
    "fastify": "^5.12.5",
    "mssql": "^12.7.2",
    "nanoid": "^6.0.1",
    "p-limit": "^7.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.3",
    "vitest": "^5.0.3"
  }
}
