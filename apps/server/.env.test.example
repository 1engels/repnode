# Copia este archivo como .env.test.local (no se versiona) y completa los datos del SQL Server de pruebas.
TEST_SQL_SERVER=192.168.x.x
# Si se indica puerto se conecta directo (no requiere SQL Server Browser); si no, se resuelve la instancia
TEST_SQL_INSTANCE=ION
TEST_SQL_PORT=1433
TEST_SQL_DATABASE=ION_Data
TEST_SQL_USER=
TEST_SQL_PASSWORD=
# Solo para autenticación Windows (NTLM)
TEST_SQL_DOMAIN=
TEST_SQL_ENCRYPT=false
TEST_SQL_TRUST_CERT=true

# Benchmark (opcional)
BENCH_METERS=50
# IDs de Quantity separados por coma; vacío = las 4 mediciones más comunes
BENCH_QUANTITIES=
BENCH_DAYS=30
# Combinaciones workers x consultas paralelas
BENCH_CONFIGS=1x1,1x4,2x4,4x4
