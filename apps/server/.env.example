# Copia este archivo como .env.local (no se versiona) en el servidor donde corre RepNode.
# `pnpm start` y `pnpm dev` lo cargan solos. Protege el archivo: contiene la contraseña de la cuenta de servicio.

# --- Servidor HTTP --------------------------------------------------------------------------------------------
# Detrás del proxy de IIS debe quedar en 127.0.0.1: así solo IIS puede llegar a RepNode
REPNODE_HOST=127.0.0.1
REPNODE_PORT=3210
# Nombres con los que los usuarios abren PME (además de localhost), separados por coma
REPNODE_ALLOWED_HOSTS=srvslvpmeapp,srvslvpmeapp.realplaza.local

# --- Conexión a la base ION_Data (cuenta de servicio, solo db_datareader) -------------------------------------
REPNODE_SERVER=
# REPNODE_INSTANCE=
REPNODE_DB_PORT=1433
REPNODE_DB_NAME=ION_Data
REPNODE_AUTH_USER=
REPNODE_AUTH_PASS=

# --- Modo multiusuario embebido en PME ------------------------------------------------------------------------
# none = app local de un usuario (por defecto); pme = usuarios de PME, autenticados con su sesión de PME
REPNODE_AUTH_MODE=pme
# Endpoint que valida la cookie de PME y devuelve el usuario. Por defecto la aplicación IIS /repnode-auth
# (deploy/iis/instalar-repnode-auth.ps1), que responde {"user":"..."}; RepNode le reenvía solo la cookie de PME.
# REPNODE_PME_USER_URL=http://127.0.0.1/repnode-auth/whoami.ashx
# Ruta con puntos al nombre de usuario dentro del JSON (por defecto "user" con el endpoint anterior)
# REPNODE_PME_USER_FIELD=user
# Cookies que se reenvían a PME (por defecto la de Forms Authentication de PME)
# REPNODE_PME_COOKIES=.APPLICATIONFRAMEWORK
# REPNODE_PME_LOGIN_URL=/Web/Auth
# Cada cuántos segundos se vuelve a confirmar con PME que la sesión sigue abierta
# REPNODE_PME_RECHECK_SECONDS=120
# El certificado de PME es autofirmado: confía en él (PEM exportado) o, solo si la URL es 127.0.0.1, no lo valides
# REPNODE_PME_CA_FILE=C:\RepNode\pme-cert.pem
# REPNODE_PME_TLS_INSECURE=1

# --- Sesiones y topes -----------------------------------------------------------------------------------------
# REPNODE_SESSION_IDLE_MINUTES=15
# REPNODE_SESSION_MAX_HOURS=12
# REPNODE_MAX_SESSIONS=100
# Conexiones máximas del pool de cada sesión (vacío = según Configuración → rendimiento)
# REPNODE_SESSION_POOL_MAX=4
# Reportes generándose a la vez (cada uno usa workers × consultas conexiones) y en cola/curso por usuario
# REPNODE_MAX_CONCURRENT_JOBS=1
# REPNODE_MAX_JOBS_PER_USER=2

# --- Datos ----------------------------------------------------------------------------------------------------
# REPNODE_DATA_DIR=C:\RepNode\data
# REPNODE_LOG_LEVEL=info
