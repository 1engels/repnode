{
  "name": "repnode",
  "private": true,
  "type": "module",
  "description": "Extractor de mediciones ION_Data (Schneider PME) a CSV",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter @repnode/server dev\" \"pnpm --filter @repnode/web dev\"",
    "build": "pnpm --filter @repnode/web build",
    "start": "pnpm --filter @repnode/server start",
    "serve": "pnpm build && pnpm start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "~6.0.3"
  }
}
