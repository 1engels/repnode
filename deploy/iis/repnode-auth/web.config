<?xml version="1.0" encoding="utf-8"?>
<!--
  Aplicación IIS /repnode-auth (ver deploy/iis/instalar-repnode-auth.ps1). Valida la cookie de sesión de PME igual que
  sus aplicaciones: mismo nombre de cookie y el machineKey que se hereda del web.config raíz del sitio. Aquí no se
  copia ninguna clave.
-->
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" />
    <authentication mode="Forms">
      <!-- slidingExpiration="false": este endpoint nunca renueva ni reemite la cookie de PME -->
      <forms name=".APPLICATIONFRAMEWORK" protection="All" slidingExpiration="false" />
    </authentication>
    <!-- Sin sesión responde 401 (el handler decide); no redirige a un login -->
    <authorization>
      <allow users="*" />
    </authorization>
    <sessionState mode="Off" />
    <customErrors mode="On" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
